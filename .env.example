# Copier en .env (jamais commité) et adapter. Aucune valeur ci-dessous n'est un secret réel.
APP_ENV=development
SECRET_KEY=changer-moi-avec-une-longue-valeur-aleatoire
BASE_URL=http://localhost:5000

# PostgreSQL : rôle applicatif (droits restreints) et rôle propriétaire (migrations)
DATABASE_URL=postgresql+psycopg://labq_app:mot-de-passe-app@localhost:5432/labqualite
DATABASE_OWNER_URL=postgresql+psycopg://labq_owner:mot-de-passe-owner@localhost:5432/labqualite
DB_APP_ROLE=labq_app

# Tests (base dédiée)
TEST_DATABASE_URL=postgresql+psycopg://labq_app:mot-de-passe-app@localhost:5432/labqualite_test
TEST_DATABASE_OWNER_URL=postgresql+psycopg://labq_owner:mot-de-passe-owner@localhost:5432/labqualite_test
TEST_DB_APP_ROLE=labq_app

# Emails : smtp | console (développement)
MAIL_BACKEND=console
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=LabQualité <no-reply@example.org>

# Pièces jointes : local | s3
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
S3_BUCKET=
S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Stripe (mode test : clés sk_test_… / whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_TAX_ENABLED=false
VAT_EXEMPTION_MENTION=TVA non applicable, art. 293 B du CGI
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_SIRET=
INVOICE_ISSUER_ADDRESS=
TRIAL_DAYS=30
GRACE_DAYS=14
DEFAULT_MAX_ACTIVE_USERS=15

# Divers
SELF_SIGNUP_ENABLED=false
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOG_LEVEL=INFO
